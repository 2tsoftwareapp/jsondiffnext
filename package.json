{
  "name": "jsondiffnext",
  "version": "0.1.0",
  "private": false,
  "description": "Hardened JSON diff/patch wrapper with multi-engine adapters, atomic apply, and SHA-256 patch guards",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truongnat/jsondiffnext.git"
  },
  "keywords": [
    "json",
    "diff",
    "patch",
    "json-patch",
    "rfc6902",
    "jsondiffpatch",
    "prototype-pollution"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --target ES2023 --module NodeNext --moduleResolution NodeNext --rewriteRelativeImportExtensions --declaration --outDir dist index.ts core.ts adapters.ts && node scripts/fix-dts.js",
    "prepack": "npm run build",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "repro": "node reproduce.ts",
    "resources": "node --expose-gc resources.ts",
    "bench": "node --expose-gc benchmark.ts",
    "summarize": "node summarize.ts"
  },
  "dependencies": {
    "jsondiffpatch": "0.7.7",
    "fast-json-patch": "3.1.1",
    "rfc6902": "5.4.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "fast-check": "4.3.0"
  },
  "engines": { "node": ">=24" }
}
